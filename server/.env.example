# Copy to server/.env for local development, and set the same variables on
# the backend host for production. Never commit the real .env file.

# MongoDB Atlas cluster "OurBestSide". Replace <db_password> with the
# database user's password (URL-encode any special characters).
MONGO_URI=mongodb+srv://dtan:<db_password>@ourbestside.wzskejs.mongodb.net/ourbestside?retryWrites=true&w=majority&appName=OurBestSide

PORT=8000

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=

# Stripe secret key (sk_test_... for test mode).
STRIPE_PRIVATE_KEY=

# Signing secret of the Stripe webhook endpoint that points at
# <backend URL>/checkout/webhook (whsec_...). Orders are only marked paid
# when this webhook is received. For local testing use `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# Currency for checkout (default: sgd).
CURRENCY=sgd

# Comma-separated ISO country codes Stripe Checkout accepts for shipping
# (default: SG), e.g. SG,MY
SHIPPING_COUNTRIES=SG

# Frontend URL, used for Stripe success/cancel redirects,
# e.g. https://ourbestside.netlify.app
BASE_URL=

# AWS S3 bucket for product images.
BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_ACCESS_KEY_SECRET=
